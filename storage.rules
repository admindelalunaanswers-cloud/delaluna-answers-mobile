rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ─── Helpers ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isVerifiedOwner(uid) {
      return isOwner(uid) && isVerified();
    }

    // Admin privilege is granted via the `admin: true` custom auth claim,
    // set by the `syncAdminClaim` Cloud Function. See firestore.rules.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isImageUnder(maxBytes) {
      return request.resource.size < maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    // ─── Card art (public read, admin-only write) ──────────────────────────
    // The home screen prefetches these via public download URLs, so they must
    // be readable without auth.
    //
    // `cards/` is where the art lives now — `cards/oracle/{id}.png` and
    // `cards/tarot/{id}.png`, resolved by `src/utils/tarot-image.ts`. Without a
    // match here it falls through to the admin-only default below and every
    // card front returns 403 rather than 404, which reads as "missing file"
    // and sends you looking in the wrong place.
    match /cards/{file=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // The flat layout the art was served from before the move. Builds already
    // on the stores still request these, so the match stays until they age out.
    match /tarot-card-front/{file=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tarot-card-back/{file=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Per-user uploads (avatars, custom artwork, etc.) ──────────────────
    // Reserved for future profile uploads — verified owner only, 5 MB image cap.
    match /users/{uid}/{file=**} {
      allow read:  if isOwner(uid) || isAdmin();
      allow write: if isVerifiedOwner(uid) && isImageUnder(5 * 1024 * 1024);
    }

    // ─── Public app assets (deploy-time only) ──────────────────────────────
    match /public/{file=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ─── Default deny ──────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
