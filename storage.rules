rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ─── Helpers ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdminEmail() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
            'jeanaicode@gmail.com',
            'admin.delalunaanswers@gmail.com',
            'delalunaanswers@gmail.com'
          ];
    }

    function isImageUnder(maxBytes) {
      return request.resource.size < maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    // ─── Tarot card art (public read, admin-only write) ────────────────────
    // The home screen prefetches these via public download URLs, so they must
    // be readable without auth.
    match /tarot-card-front/{file=**} {
      allow read: if true;
      allow write: if isAdminEmail();
    }

    match /tarot-card-back/{file=**} {
      allow read: if true;
      allow write: if isAdminEmail();
    }

    // ─── Per-user uploads (avatars, custom artwork, etc.) ──────────────────
    // Reserved for future profile uploads — owner-only with a 5 MB image cap.
    match /users/{uid}/{file=**} {
      allow read:  if isOwner(uid) || isAdminEmail();
      allow write: if isOwner(uid) && isImageUnder(5 * 1024 * 1024);
    }

    // ─── Public app assets (deploy-time only) ──────────────────────────────
    match /public/{file=**} {
      allow read:  if true;
      allow write: if isAdminEmail();
    }

    // ─── Default deny ──────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if isAdminEmail();
    }
  }
}
