# dependencies
node_modules/

# Firebase emulator seed data
seed/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts                   

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
*-debug.log
firebase-debug.log
firestore-debug.log

# Firebase emulator & CLI logs
.firebase/

# Firebase Functions compiled output
functions/lib/

# macOS
.DS_Store
*.pem

# VSCode local settings
.vscode/settings.local.json

# local env files
.env
.env*.local

# Firebase extension secrets (contain API keys — never commit)
extensions/*.secret.local

# EAS / signing credentials (contain cert passwords — never commit)
credentials.json
credentials/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
app.apk
/scripts

# local Claude Code config
.claude/
SLASH_COMMANDS.md
