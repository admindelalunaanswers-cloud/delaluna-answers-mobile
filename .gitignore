# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Firebase emulator seed data
seed/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
*-debug.log
firebase-debug.log
firestore-debug.log

# Firebase emulator & CLI logs
.firebase/

# Firebase Functions compiled output
functions/lib/

# Firebase Data Connect generated schema introspection
dataconnect/.dataconnect/

# macOS
.DS_Store
*.pem

# VSCode local settings
.vscode/settings.local.json

# local env files
.env
.env.backup
.env*.local

# Firebase extension secrets (contain API keys — never commit)
extensions/*.secret.local

# typescript
*.tsbuildinfo

# test coverage
coverage/

# generated native folders
/ios
/android
app.apk

# local-only scripts, except the ones package.json references by path — those
# have to survive a fresh clone or the npm script fails with a missing module
# (note: /scripts/* not /scripts — git won't descend into an excluded directory,
# so the negation below only works if the directory itself stays untracked-eligible)
/scripts/*
!/scripts/exclude-dev-client.js
!/scripts/sync-admin-env.js
!/scripts/regenerate-user.js

# credentials
/credentials.json
credentials/

# Backups taken by scripts/regenerate-user.js before it deletes anything.
# These hold whole prompt bodies, which carry birth data — never commit them.
/.regen-backups/

# local Claude Code config
.claude/
SLASH_COMMANDS.md
/CLAUDE.md
THREAT_MODEL.md

# session memory / handoff files
.remember/

# docs generated locally
docs/firebase-monitoring-dev.md
docs/firebase-monitoring-overview.md
docs/TESTING_GUIDE.md

