{
  "cli": {
    "version": ">= 16.6.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "channel": "development-device",
      "env": {
        "APP_ENV": "development",
        "EAS_UPDATE_CHANNEL": "development-device",
        "USE_EMULATOR": "true"
      }
    },
    "preview-device": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "channel": "preview-device",
      "env": {
        "APP_ENV": "preview",
        "EAS_UPDATE_CHANNEL": "preview-device"
      }
    },
    "production": {
      "developmentClient": false,
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      },
      "channel": "production",
      "env": {
        "APP_ENV": "production",
        "EAS_UPDATE_CHANNEL": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
