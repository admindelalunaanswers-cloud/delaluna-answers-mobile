{
  "name": "delaluna-answers-mobile",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "scripts": {
    "start": "expo start -c",
    "Firebase Reauth": "firebase login --reauth",
    "emulators": "firebase emulators:start --only auth,functions,firestore,storage,eventarc,extensions --import=./seed --export-on-exit=./seed",
    "dev": "concurrently -k -n EMU,EXPO -c cyan,magenta \"firebase emulators:start --only auth,functions,firestore,storage,eventarc,extensions --import=./seed --export-on-exit=./seed\" \"expo start\"",
    "seed:export": "firebase emulators:export ./seed",
    "reset-project": "node ./scripts/reset-project.js",
    "eas-build-pre-install": "node ./scripts/exclude-dev-client.js",
    "migrate:users-to-dllap": "node ./scripts/migrate-users-to-dllap.js",
    "admin:dev": "node ./scripts/sync-admin-env.js test && npm --prefix admin-web run dev",
    "admin:build:test": "node ./scripts/sync-admin-env.js test && npm --prefix admin-web run build",
    "admin:build:prod": "node ./scripts/sync-admin-env.js prod && npm --prefix admin-web run build",
    "admin:deploy:test": "npm run admin:build:test && firebase deploy --only hosting --project delaluna-answers-test",
    "admin:deploy:prod": "npm run admin:build:prod && firebase deploy --only hosting --project delaluna-answers",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "build:dev-sim": "eas build --profile development-simulator --platform all",
    "build:dev-device": "eas build --profile development-device --platform all",
    "build:preview": "eas build --profile preview-device --platform all",
    "build:prod": "eas build --profile production --platform all",
    "update:preview": "eas update --channel preview-device --environment preview --message ",
    "update:prod": "eas update --channel production --environment production --message ",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-firebase/analytics": "^24.0.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/crashlytics": "^24.0.0",
    "@react-native-firebase/perf": "^24.0.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "concurrently": "^9.2.1",
    "expo": "~54.0.33",
    "expo-apple-authentication": "~8.0.8",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-insights": "~0.10.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-screen-orientation": "~9.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.10",
    "firebase": "^12.10.0",
    "lottie-react-native": "~7.3.1",
    "punycode": "^2.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-purchases": "^9.15.1",
    "react-native-purchases-ui": "^9.15.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-swisseph": "^0.2.1",
    "react-native-worklets": "0.5.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@react-native-community/cli": "^20.1.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "~19.1.0",
    "babel-jest": "^30.3.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "firebase-admin": "^13.8.0",
    "globals": "^17.6.0",
    "jest": "^30.3.0",
    "jiti": "^2.7.0",
    "react-refresh": "^0.18.0",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.4.9",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.59.4"
  },
  "private": true,
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "protobufjs@7.6.5": true,
    "unrs-resolver@1.12.2": true
  },
  "volta": {
    "node": "20.19.5"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-dev-client",
        "expo-dev-launcher",
        "expo-dev-menu"
      ]
    }
  }
}
