{
  "name": "delaluna-answers-mobile",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "scripts": {
    "start": "expo start -c",
    "Firebase Reauth": "firebase login --reauth",
    "emulators": "firebase emulators:start --only auth,functions,firestore,storage,eventarc,extensions --import=./seed --export-on-exit=./seed",
    "dev": "concurrently -k -n EMU,EXPO -c cyan,magenta \"firebase emulators:start --only auth,functions,firestore,storage,eventarc,extensions --import=./seed --export-on-exit=./seed\" \"expo start\"",
    "seed:export": "firebase emulators:export ./seed",
    "reset-project": "node ./scripts/reset-project.js",
    "eas-build-pre-install": "node ./scripts/exclude-dev-client.js",
    "migrate:users-to-dllap": "node ./scripts/migrate-users-to-dllap.js",
    "regen:user": "node ./scripts/regenerate-user.js",
    "cleanup:orphans": "node ./scripts/cleanup-orphaned-connection-data.js",
    "env:prod": "node ./scripts/switch-env.js prod",
    "env:test": "node ./scripts/switch-env.js test",
    "admin:dev": "node ./scripts/sync-admin-env.js test && npm --prefix admin-web run dev",
    "admin:build:test": "node ./scripts/sync-admin-env.js test && npm --prefix admin-web run build",
    "admin:build:prod": "node ./scripts/sync-admin-env.js prod && npm --prefix admin-web run build",
    "admin:deploy:test": "npm run admin:build:test && firebase deploy --only hosting --project delaluna-answers-test",
    "admin:deploy:prod": "npm run admin:build:prod && firebase deploy --only hosting --project delaluna-answers",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "build:dev-sim": "eas build --profile development-simulator --platform all",
    "build:dev-device": "eas build --profile development-device --platform all",
    "build:preview": "eas build --profile preview-device --platform all",
    "build:prod": "eas build --profile production --platform all",
    "update:preview": "eas update --channel preview-device --environment preview --message ",
    "update:prod": "eas update --channel production --environment production --message ",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-firebase/analytics": "^24.0.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/crashlytics": "^24.0.0",
    "@react-native-firebase/perf": "^24.0.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "concurrently": "^9.2.1",
    "expo": "~57.0.25",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.20",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-insights": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.23",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.10.0",
    "lottie-react-native": "~7.3.1",
    "punycode": "^2.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-purchases": "^10.10.2",
    "react-native-purchases-ui": "^10.10.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-swisseph": "^0.2.1",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@react-native-community/cli": "^20.2.0",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^25.6.0",
    "@types/react": "~19.2.4",
    "babel-jest": "~29.7.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-react": "^7.37.5",
    "firebase-admin": "^13.8.0",
    "globals": "^17.6.0",
    "jest": "~29.7.0",
    "jiti": "^2.7.0",
    "react-refresh": "^0.18.0",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.4.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "private": true,
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "protobufjs@7.6.5": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "react-native-markdown-display": {
      "markdown-it": "^14.3.3"
    }
  },
  "volta": {
    "node": "20.19.5"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-dev-client",
        "expo-dev-launcher",
        "expo-dev-menu"
      ]
    }
  }
}
