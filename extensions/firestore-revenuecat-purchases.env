ALLOWED_EVENT_TYPES=com.revenuecat.v1.billing_issue,com.revenuecat.v1.cancellation,com.revenuecat.v1.expiration,com.revenuecat.v1.initial_purchase,com.revenuecat.v1.non_renewing_purchase,com.revenuecat.v1.product_change,com.revenuecat.v1.renewal,com.revenuecat.v1.subscriber_alias,com.revenuecat.v1.subscription_paused,com.revenuecat.v1.test,com.revenuecat.v1.transfer,com.revenuecat.v1.uncancellation
EVENTARC_CHANNEL=projects/delaluna-answers/locations/us-central1/channels/firebase
firebaseextensions.v1beta.function/memory=256
firebaseextensions.v1beta.function/minInstances=0
firebaseextensions.v1beta.function/vpcConnectorEgressSettings=VPC_CONNECTOR_EGRESS_SETTINGS_UNSPECIFIED
LOCATION=us-central1
REVENUECAT_CUSTOMERS_COLLECTION=subscriptions/purchaser-info/customers
REVENUECAT_EVENTS_COLLECTION=subscriptions/purchases/users
REVENUECAT_SHARED_SECRET=projects/${param:PROJECT_NUMBER}/secrets/firestore-revenuecat-purchases-REVENUECAT_SHARED_SECRET/versions/latest
SET_CUSTOM_CLAIMS=ENABLED