API_KEY=projects/${param:PROJECT_NUMBER}/secrets/firestore-tarot-chatbot-API_KEY/versions/latest
CANDIDATE_COUNT=1
CANDIDATES_FIELD=candidates
COLLECTION_NAME=users/{UID}/tarotChat
ENABLE_DISCUSSION_OPTION_OVERRIDES=no
ENABLE_GENKIT_MONITORING=no
firebaseextensions.v1beta.function/memory=256
firebaseextensions.v1beta.function/minInstances=0
firebaseextensions.v1beta.function/vpcConnectorEgressSettings=VPC_CONNECTOR_EGRESS_SETTINGS_UNSPECIFIED
GENERATIVE_AI_PROVIDER=google-ai
HARM_CATEGORY_DANGEROUS_CONTENT=BLOCK_MEDIUM_AND_ABOVE
HARM_CATEGORY_HARASSMENT=BLOCK_MEDIUM_AND_ABOVE
HARM_CATEGORY_HATE_SPEECH=BLOCK_MEDIUM_AND_ABOVE
HARM_CATEGORY_SEXUALLY_EXPLICIT=BLOCK_ONLY_HIGH
LOCATION=us-central1
MODEL=gemini-2.5-flash
ORDER_FIELD=createTime
PROMPT_FIELD=prompt
RESPONSE_FIELD=response
TEMPERATURE=0.3
VERTEX_AI_MODEL_LOCATION=null