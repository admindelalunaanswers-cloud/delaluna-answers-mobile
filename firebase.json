{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099,
      "host": "0.0.0.0"
    },
    "functions": {
      "port": 5001,
      "host": "0.0.0.0"
    },
    "firestore": {
      "port": 8080,
      "host": "0.0.0.0"
    },
    "database": {
      "port": 9000,
      "host": "0.0.0.0"
    },
    "storage": {
      "port": 9199,
      "host": "0.0.0.0"
    },
    "eventarc": {
      "port": 9299,
      "host": "0.0.0.0"
    },
    "ui": {
      "enabled": true,
      "host": "0.0.0.0"
    },
    "singleProjectMode": true,
    "extensions": {},
    "dataconnect": {
      "dataDir": "dataconnect/.dataconnect/pgliteData"
    }
  },
  "extensions": {
    "delete-user-data": "firebase/delete-user-data@0.1.28",
    "firestore-genai-chatbot": "googlecloud/firestore-genai-chatbot@0.0.19",
    "firestore-genai-chatbot-1rrn": "googlecloud/firestore-genai-chatbot@0.0.19",
    "firestore-genai-chatbot-update-5i5h": "googlecloud/firestore-genai-chatbot@0.0.19",
    "firestore-natal-chart-chatbot-6ppy": "googlecloud/firestore-genai-chatbot@0.0.19",
    "firestore-revenuecat-purchases": "revenuecat/firestore-revenuecat-purchases@0.1.18",
    "firestore-transits-chatbot-cgl7": "googlecloud/firestore-genai-chatbot@0.0.19",
    "horoscope-chatbot-b6wc": "googlecloud/firestore-genai-chatbot@0.0.19"
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "dataconnect": {
    "source": "dataconnect"
  }
}
