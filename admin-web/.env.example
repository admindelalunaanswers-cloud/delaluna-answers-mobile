# Firebase web config for the admin dashboard.
#
# None of these are secrets — the same values ship inside every installed copy
# of the mobile app, and Firebase web config is public by design. Access is
# controlled by the `admin` custom auth claim and the Firestore rules.
#
# Copy to `.env` and fill in. Values come from the Firebase console:
#   Project settings → Your apps → Web app → SDK setup and configuration
#
# For the TEST project (delaluna-answers-test) use env.test.local at the repo
# root. For PRODUCTION (delaluna-answers) use env.prod.local. Develop against
# test; that is the whole reason two projects exist.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
